# ProjectForge backend configuration. Copy to backend/.env and adjust.
# Every value is optional: with nothing set, the backend uses a local SQLite file
# (backend/projectforge.db), seeds the demo team and runs in demo mode.

# development | production. Production requires JWT_SECRET and turns demo mode off by default.
ENVIRONMENT=development

# PostgreSQL / Supabase connection string. Leave empty for the zero-config SQLite demo.
# Supabase: Project Settings -> Database -> Connection string (URI), e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Fall back to SQLite when the Postgres URL above cannot be reached.
DB_FALLBACK_TO_SQLITE=true
# SQLite file used when no DATABASE_URL is set.
# SQLITE_PATH=./projectforge.db

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty in development, a random secret is stored in backend/.dev_jwt_secret.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=480
MFA_TOKEN_MINUTES=5
RESET_TOKEN_MINUTES=30
UNLOCK_TOKEN_MINUTES=1440
BCRYPT_ROUNDS=12

# Brute-force protection (UC-08, UC-09, UC-10).
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=30

# SE-NFR-06: redirect http -> https and send HSTS. Defaults to true whenever DEMO_MODE=false.
# Behind a TLS-terminating proxy, run: uvicorn app.main:app --proxy-headers --forwarded-allow-ips="*"
FORCE_HTTPS=

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used to build the links in reset / unlock emails.
FRONTEND_URL=http://localhost:5173

# Demo mode enables the one-click role switcher, the 2FA demo code and the dev email outbox.
# NEVER enable it on a public deployment.
DEMO_MODE=true
DEMO_PASSWORD=ProjectForge!1
DEMO_MFA_CODE=123456
SEED_DEMO_DATA=true

# In demo mode every sign-in asks for the 6-digit code (UC-09). Outside demo mode only accounts that turned
# 2FA on are asked, so this switch has no effect there.
REQUIRE_MFA=true

# UC-22: how often the server creates deadline reminders (tasks and soft deadlines due within 24 hours).
# 0 turns the timer off; POST /api/notifications/reminders/run still runs the same job on demand.
REMINDER_INTERVAL_SECONDS=300

# UC-14 / UC-15: OAuth applications for Google Calendar / Sheets and Outlook (Microsoft Graph). Leave empty and
# those export targets answer 503 "not set up on this server" (nothing is sent). The token exchange that creates
# events or sheets is NOT built yet, so a configured app only unlocks add-to-calendar links.
# Never commit real values; put them in backend/.env only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
